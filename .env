# 写真/レシート読み取りとバックエンドAI(第2層)は初回リリースでは見送り。
# 未設定＝extractAvailable()がfalse＝読み取りUIを出さない。オンデバイスAI＋内蔵90品で動く。
# 復活させる時: supabase functions deploy extract/decide 後にURLを設定する。
# EXPO_PUBLIC_DECIDE_URL=https://YOUR-PROJECT.supabase.co/functions/v1/decide

# AdMob実広告。AdMobのネイティブモジュール入りdev buildが必要（ビルド済み）。
# 切り替えはMetro再起動で反映される（アプリの再ビルドは不要）。
# v1は live + 実IDで提出する（AdMobの配信審査が通るまでは枠が空のまま＝表示されないだけで無害。
# 各広告コンポーネントはロード失敗時に何も描画しないフォールバック済み）。
EXPO_PUBLIC_ADS_MODE=live
# 下記3つは「今日飯」(App ID ~4198812026) のユニットID。
# ※「あとで」(~5202751986) のIDと取り違えないこと（2026-07-16に一度取り違えて巻き戻した）。
EXPO_PUBLIC_ADMOB_NATIVE_UNIT_ID_IOS=ca-app-pub-4221751682881809/9339458066
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID_IOS=ca-app-pub-4221751682881809/4376986989
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-4221751682881809/9936324057
