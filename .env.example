# 提案は3層フォールバック: ①オンデバイスAI(無料) → ②バックエンドAI(下記URL) → ③内蔵69献立。
# オンデバイス①と内蔵③だけで運用コスト0で動くため、②のURLは任意（未設定でも可）。
# 値は .env にコピーして設定（APIキーはここに置かない。サーバ側シークレットのみ）。
EXPO_PUBLIC_DECIDE_URL=https://YOUR-PROJECT.supabase.co/functions/v1/decide

# オンデバイスAI提案（Apple Foundation Models）。auto=対応端末で使う（既定）／off=常に無効。
# 実際に使えるかは端末側の可用性判定で最終ゲートするので、非対応端末では自動で②③へ降格。
EXPO_PUBLIC_ONDEVICE_MODE=auto

# 本番MVPでは未接続の収益機能を出さない。
# 開発中に旧モックUIを触る場合だけ mock / placeholder にする。
# ADS_MODE: disabled=出さない／placeholder=旧モックUI（実SDK未接続の開発確認用）／live=AdMob実広告。
EXPO_PUBLIC_PURCHASES_MODE=disabled
EXPO_PUBLIC_ADS_MODE=disabled

# AdMob広告ユニットID（liveモード時のみ使用。App ID自体はapp.jsonのplugins設定側）。
# AdMobダッシュボード（https://apps.admob.com）の「広告ユニット」から取得。
# Android側は未登録のため、Google公式テストID（TestIds）に自動フォールバックする実装にしてある。
EXPO_PUBLIC_ADMOB_NATIVE_UNIT_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/WWWWWWWWWW
